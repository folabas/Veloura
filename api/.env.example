# Copy to .env for local use. On Render, add these under the service's Environment tab.
# Never commit the real values.

# MongoDB Atlas connection string, with the database user's password filled in.
# Atlas → Connect → Drivers. If the password has symbols like @ : / ? # % , URL-encode them.
MONGODB_URI=mongodb+srv://olajideizuna_db_user:<db_password>@cluster0.e9ydlul.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=veloura

# Sign-in for the admin panel (/admin). The username ignores capital letters; use a long password.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Long random string that signs admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# This API's public address, used in image links. On Render: https://<service-name>.onrender.com
PUBLIC_URL=http://localhost:4000

# Optional: lets saves show on the website immediately.
# FRONTEND_REVALIDATE_URL=https://<your-site>.vercel.app/api/revalidate
# REVALIDATE_SECRET=<same value as on Vercel>
