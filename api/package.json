{
    "name":  "veloura-api",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "scripts":  {
                    "dev":  "tsx watch --env-file=.env src/server.ts",
                    "build":  "tsc -p tsconfig.json",
                    "start":  "node dist/server.js",
                    "seed":  "tsx --env-file-if-exists=.env scripts/seed.ts",
                    "typecheck":  "tsc -p tsconfig.json --noEmit"
                },
    "dependencies":  {
                         "cookie-parser":  "^1.4.7",
                         "cors":  "^2.8.5",
                         "express":  "^5.1.0",
                         "express-rate-limit":  "^7.5.1",
                         "helmet":  "^8.1.0",
                         "jsonwebtoken":  "^9.0.2",
                         "mongodb":  "^6.16.0",
                         "multer":  "^2.4.0",
                         "sharp":  "^0.35.5",
                         "zod":  "^3.25.76"
                     },
    "devDependencies":  {
                            "@types/cookie-parser":  "^1.4.9",
                            "@types/cors":  "^2.8.19",
                            "@types/express":  "^5.0.3",
                            "@types/jsonwebtoken":  "^9.0.10",
                            "@types/multer":  "^2.0.0",
                            "@types/node":  "^22.15.30",
                            "tsx":  "^4.20.3",
                            "typescript":  "^5.8.3"
                        }
}