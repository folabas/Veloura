{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "veloura-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    },
    {
      "name": "veloura-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "start", "--", "-p", "3001"],
      "port": 3001
    },
    {
      "name": "veloura-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "api", "run", "dev"],
      "port": 4000
    }
  ]
}
